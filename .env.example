# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL / custom domain where this academy is hosted.
APP_URL="https://noorwbayan-academy.com"

# SESSION_SECRET: Required in production (min 24 random chars) for signing auth tokens.
# Generate via: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# NODE_ENV: Set to "production" on live hosting.
NODE_ENV="development"

# TRUST_PROXY_HOPS: Number of reverse-proxy hops to trust for client IP extraction (default 1).
TRUST_PROXY_HOPS="1"

# SUPABASE CONFIGURATION (Add when connecting your live Supabase project)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Server-only secret — NEVER prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=""

# CORS_ALLOWED_ORIGINS: Optional comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=""

# IBAN_ENCRYPTION_KEY / IBAN_ENCRYPTION_KEY_PREVIOUS: AES-256-GCM key ring for teacher IBAN encryption.
# IMPORTANT: Keep an offline backup — losing the key means losing every stored IBAN.
IBAN_ENCRYPTION_KEY=""
IBAN_ENCRYPTION_KEY_PREVIOUS=""

# CLOUDFLARE TURNSTILE (Optional anti-bot verification on login & public forms)
TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""

# AUDIT_LOG_RETENTION_MONTHS: Number of months to retain immutable audit logs (default 24)
AUDIT_LOG_RETENTION_MONTHS="24"

# REQUIRE_EMAIL_VERIFICATION: Require email-ownership confirmation on non-Google sign-ups after admin approval (default false)
REQUIRE_EMAIL_VERIFICATION="false"


