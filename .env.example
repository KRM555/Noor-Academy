# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL / custom domain where this academy is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Required in production (min 24 random chars) for signing auth tokens.
# Generate via: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET"

# NODE_ENV: Set to "production" on live hosting.
NODE_ENV="development"

# TRUST_PROXY_HOPS: Number of reverse-proxy hops to trust for client IP extraction (default 1).
TRUST_PROXY_HOPS="1"

# SUPABASE CONFIGURATION (Add when connecting your live Supabase project)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Server-only secret — NEVER prefix with VITE_
SUPABASE_SERVICE_ROLE_KEY=""

# CORS_ALLOWED_ORIGINS: Optional comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=""
